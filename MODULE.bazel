http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_xcodeproj", version = "2.10.0")
bazel_dep(
    name = "apple_support",
    version = "1.17.1",
    repo_name = "build_bazel_apple_support",
)
bazel_dep(
    name = "rules_swift",
    version = "2.5.0",
    repo_name = "build_bazel_rules_swift",
)
bazel_dep(
    name = "rules_apple",
    version = "3.19.0",
    repo_name = "build_bazel_rules_apple",
)

bazel_dep(
    name = "buildifier_prebuilt",
    version = "6.4.0",
    dev_dependency = True,
)


bazel_dep(
    name = "bazel_skylib_gazelle_plugin",
    version = "1.7.1",
    dev_dependency = True,
)
bazel_dep(
    name = "gazelle",
    version = "0.42.0",
    dev_dependency = True,
    repo_name = "bazel_gazelle",
)

http_archive(
    name = "Alamofire",
    urls = ["https://github.com/Alamofire/Alamofire/archive/refs/tags/5.7.0.zip"],
    strip_prefix = "Alamofire-5.7.0",
    build_file = "//Source/third_party/Alamofire:BUILD.bazel"
)

http_archive(
    name = "Kingfisher",
    urls = ["https://github.com/onevcat/Kingfisher/archive/refs/tags/6.2.1.zip"],
    strip_prefix = "Kingfisher-6.2.1",
    build_file = "//Source/third_party/Kingfisher:BUILD.bazel"
)
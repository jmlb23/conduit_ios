http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
bazel_dep(name = "rules_xcodeproj", version = "4.0.0")
bazel_dep(
    name = "apple_support",
    version = "1.24.2",
    repo_name = "build_bazel_apple_support",
)
bazel_dep(
    name = "rules_swift",
    version = "3.5.0",
    repo_name = "build_bazel_rules_swift",
)
bazel_dep(
    name = "rules_apple",
    version = "4.2.0",
    repo_name = "build_bazel_rules_apple",
)

http_archive(
    name = "Alamofire",
    urls = ["https://github.com/Alamofire/Alamofire/archive/refs/tags/5.7.0.zip"],
    strip_prefix = "Alamofire-5.7.0",
    build_file = "//Source/third_party/Alamofire:BUILD.bazel"
)

http_archive(
    name = "Kingfisher",
    urls = ["https://github.com/onevcat/Kingfisher/archive/refs/tags/6.2.1.zip"],
    strip_prefix = "Kingfisher-6.2.1",
    build_file = "//Source/third_party/Kingfisher:BUILD.bazel"
)
